# Copy this file to .env (which is gitignored) and put your real values there.
# Never commit a real key in this template.
# For EAS builds, set the same variables as EAS environment variables:
#   eas env:create --environment production --name <NAME> --value <VALUE>

# Google Places API Key
# Get your key from: https://console.cloud.google.com/apis/credentials
# Restrict it to the Places API (New) + your app identifiers.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# RevenueCat public SDK keys (Project settings -> API keys).
# Without these the app runs in demo mode and cannot sell subscriptions.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_sdk_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_sdk_key_here

# Optional: SHA-1 of the Android release signing cert (Play Console -> App
# integrity), required only if the Places key uses Android app restriction.
# EXPO_PUBLIC_ANDROID_CERT_SHA1=
